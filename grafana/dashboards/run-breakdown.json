                        "function_call": {
                          "text": "Tool call"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "startMs"
              },
              "properties": [
                {
                  "id": "displayName",
