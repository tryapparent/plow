          "hide": 2
        },
        {
          "name": "operation",
          "label": "Timeline operation",
          "type": "custom",
          "query": "All operations : all,Provider,T3 admission,Outside runs,Provider run,Provider operations,Command execution,Tool call,Request to provider start,Between recorded runs,Missing clocks",
