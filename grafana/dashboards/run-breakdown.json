                {
                  "id": "unit",
                  "value": "ms"
                },
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-background",
                    "mode": "basic"
                  }
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "#FFF4DF"
                  }
                },
                {
                  "id": "mappings",
                  "value": [
                    {
                      "type": "special",
                      "options": {
                        "match": "null",
                        "result": {
                          "text": "Unknown",
                          "color": "#392820"
