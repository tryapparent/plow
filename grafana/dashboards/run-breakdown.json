                  ]
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "runId"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Run ID"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "events"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Events"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "paired"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Pairs"
                },
                {
                  "id": "custom.width",
                  "value": 90
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "unknown"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Unknown calls"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "sourceComplete"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Source read"
                },
                {
                  "id": "custom.cellOptions",
                  "value": {
                    "type": "color-background",
                    "mode": "basic"
                  }
                },
                {
                  "id": "mappings",
                  "value": [
                    {
                      "type": "value",
                      "options": {
                        "true": {
                          "text": "Complete",
                          "color": "#FFF4DF"
                        },
                        "false": {
                          "text": "Partial",
                          "color": "#392820"
