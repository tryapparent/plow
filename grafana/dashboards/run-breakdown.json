[
  {
    "uid": "plow-run-breakdown",
    "title": "Plow historical runs",
    "schemaVersion": 41,
    "version": 4,
    "editable": false,
    "timezone": "utc",
    "time": {
      "from": "2025-06-03T11:59:00.000Z",
      "to": "2025-06-03T12:01:00.000Z"
    },
    "templating": {
      "list": [
        {
          "name": "runId",
          "label": "Run ID",
          "type": "textbox",
          "description": "Run to look up. The dashboard time range selects the source time of its evidence.",
          "query": "fixture-run",
          "current": {
            "text": "fixture-run",
            "value": "fixture-run"
          }
        },
        {
          "name": "history",
          "hide": 2,
          "type": "textbox",
          "query": "",
          "current": {
            "text": "",
            "value": ""
          }
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "type": "table",
        "title": "Run breakdown",
        "description": "Use the selector below the table to view intervals, findings, or coverage for the selected run. Coverage describes the source read for this time range. Set the time range to include the run's source timestamps.",
        "gridPos": {
          "x": 0,
          "y": 3,
          "w": 24,
          "h": 8
        },
        "datasource": {
          "type": "plow-agent-observability-datasource",
          "uid": "plow-agent-observability"
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "plow-agent-observability-datasource",
              "uid": "plow-agent-observability"
            },
            "runId": "$runId",
            "history": "$history"
          }
