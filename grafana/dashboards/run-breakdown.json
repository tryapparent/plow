                {
                  "id": "displayName",
                  "value": "Elapsed"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Operation"
              },
              "properties": [
                {
                  "id": "links",
                  "value": [
                    {
                      "title": "Filter timeline",
                      "url": "/d/plow-activity/activity?var-range=${range:percentencode}&var-operation=${__value.raw:percentencode}&${__url_time_range}"
